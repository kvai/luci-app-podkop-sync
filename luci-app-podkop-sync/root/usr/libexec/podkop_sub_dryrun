#!/bin/sh
# podkop_sub_dryrun — пробная сборка конфига sing-box кодом самого podkop,
# БЕЗ остановки чего-либо. Отвечает на вопрос «запустится ли podkop с таким
# списком нод» до того, как список будет записан.
#
# Зачем: `podkop reload` сначала останавливает sing-box (а с ним DNS всей сети)
# и только потом собирает конфиг; если конфиг не собрался, сеть остаётся лежать.
#
# Использование: podkop_sub_dryrun <секция> <файл со ссылками> <куда писать конфиг>
# Коды возврата:
#   0 — конфиг собран и прошёл `sing-box check`;
#   1 — podkop с этим списком не запустится (причина — в <конфиг>.log и <конфиг>.err);
#   3 — проверка недоступна (у этой версии podkop другое внутреннее устройство);
#       вызывающий в этом случае полагается на откат после неудачного запуска.
#
# Скрипт подключает /usr/bin/podkop как библиотеку и опирается на его
# внутренние функции. Если после обновления podkop их не окажется — вернётся 3.
# Ничего не пишет ни в /etc, ни в рабочие файлы podkop, ни в системный лог.

SECTION="$1"; LIST="$2"; OUT="$3"
[ -n "$SECTION" ] && [ -r "$LIST" ] && [ -n "$OUT" ] || exit 3
[ -r /usr/bin/podkop ] || exit 3

# «show_version» — безобидная команда: podkop выполнит её и вернёт управление,
# оставив в этом процессе все свои функции и прочитанный конфиг.
set -- show_version
. /usr/bin/podkop >/dev/null 2>&1

type sing_box_init_config >/dev/null 2>&1 || exit 3
type sing_box_cm_save_config_to_file >/dev/null 2>&1 || exit 3
type config_set >/dev/null 2>&1 || exit 3

# Сообщения podkop — в файл: в системном логе его интерфейс показал бы их как ошибки.
log() { echo "[${2:-info}] $1" >> "$OUT.log"; }

# Новый список подставляем только в память этого процесса.
config_set "$SECTION" urltest_proxy_links "$(tr '\n' ' ' < "$LIST")"

# Вместо «проверить и заменить боевой конфиг» — «сохранить в сторону и проверить».
sing_box_save_config() {
	sing_box_cm_save_config_to_file "$config" "$OUT" || exit 1
	sing-box -c "$OUT" check >/dev/null 2>"$OUT.err" || exit 1
}

sing_box_init_config
exit 0
