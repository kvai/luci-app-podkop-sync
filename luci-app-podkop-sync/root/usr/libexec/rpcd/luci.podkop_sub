#!/bin/sh
# rpcd-провайдер ubus-объекта luci.podkop_sub для фронтенда LuCI.
# Тонкая обёртка над /usr/libexec/podkop_sub_service — вся логика там.

SVC="/usr/libexec/podkop_sub_service"

case "$1" in
	list)
		# объявляем методы (без обязательных аргументов — конфиг читается из UCI)
		echo '{ "sync": {}, "status": {}, "update_cron": {} }'
		;;
	call)
		case "$2" in
			sync)
				# Синхронизация идёт отдельным процессом: с проверкой конфига, перезапуском
				# podkop и возможным откатом она длится до минуты — дольше, чем веб-интерфейс
				# ждёт один запрос (20 с), а оборванный на середине sync оставил бы сеть
				# лежать. Ждём недолго и отдаём статус; если не успела, в нём будет
				# "running": true, и интерфейс сам опрашивает статус до завершения.
				# «force»: человек нажал кнопку, память об отвергнутом наборе не мешает.
				( "$SVC" sync force >/dev/null 2>&1 & )
				sleep 1
				i=0
				while [ $i -lt 7 ] && [ -d /tmp/podkop_sub.lock ]; do
					sleep 1
					i=$((i + 1))
				done
				"$SVC" status
				;;
			status)
				"$SVC" status
				;;
			update_cron)
				"$SVC" update_cron >/dev/null 2>&1
				echo '{ "ok": true }'
				;;
			*)
				echo '{ "error": "unknown method" }'
				;;
		esac
		;;
esac
