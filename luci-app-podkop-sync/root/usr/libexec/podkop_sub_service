#!/bin/sh
# podkop_sub_service — бэкенд синхронизации подписок для podkop.
#
# Команды:
#   sync            Скачать подписки, распарсить и записать ноды в podkop (fail-safe).
#   update_cron     Пересобрать задачу cron по значению podkop_sub.config.cron.
#   status          Вывести JSON со статусом последнего обновления и списком нод.
#   sections        Вывести JSON-массив секций /etc/config/podkop (для UI).
#
# Безопасность: все временные файлы — только в /tmp (tmpfs). Рабочий
# /etc/config/podkop НЕ трогается, если скачивание упало или парсер вернул 0 нод.

. /lib/functions.sh

# rpcd/cron запускают нас с урезанным PATH — задаём явно и резолвим python.
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
PYTHON="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"

PARSER="/usr/bin/podkop_sync.py"
TMPDIR="/tmp/podkop_sub"
CRON_FILE="/etc/crontabs/root"
CRON_MARK="# podkop_sub_sync"

log() { logger -t podkop_sub -p "daemon.$1" "$2"; }

json_escape() {
	# экранирование строки для JSON
	sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' \
		-e ':a;N;$!ba;s/\n/\\n/g'
}

# --- запись статуса в /etc/config/podkop_sub -------------------------------
set_status() {
	# $1=status  $2=message  [$3=count]
	uci -q set podkop_sub.config.last_status="$1"
	uci -q set podkop_sub.config.last_message="$2"
	uci -q set podkop_sub.config.last_update="$(date +%s)"
	[ -n "$3" ] && uci -q set podkop_sub.config.last_count="$3"
	uci -q commit podkop_sub
}

# --- чтение конфигурации плагина -------------------------------------------
URLS=""
add_url() { [ -n "$1" ] && URLS="$URLS
$1"; }

load_cfg() {
	config_load podkop_sub
	config_get ENABLED      config enabled         "1"
	config_get SECTION      config section         "main"
	config_get DEDUP        config deduplicate      "1"
	config_get PRESERVE     config preserve_manual  "1"
	config_get CRON         config cron            "24"
	config_get USER_AGENT   config user_agent      "v2rayNG/1.9.5"
	config_get MANUAL       config manual_nodes    ""
	config_list_foreach config url add_url
}

# каталог реестра «управляемых» ссылок (что плагин добавил в прошлый раз),
# по файлу на секцию — чтобы при обновлении сносить только свои ноды.
MANAGED_DIR="/etc/podkop_sub.managed.d"
managed_file() { echo "$MANAGED_DIR/$1"; }

# Проверка зависимостей: если бинарь есть — пропускаем; если нет — ставим
# через opkg (актуально для ручной/git-установки; для .ipk зависимости уже
# подтянуты). Список пар "пакет:бинарь". Возвращает 1, если что-то не удалось.
check_deps() {
	local pair pkg bin updated=0 missing=0
	for pair in python3-light:python3 curl:curl; do
		pkg="${pair%%:*}"; bin="${pair##*:}"
		command -v "$bin" >/dev/null 2>&1 && continue
		log warn "dependency '$bin' ($pkg) not found — installing via opkg"
		if [ "$updated" = 0 ]; then opkg update >/dev/null 2>&1; updated=1; fi
		opkg install "$pkg" >/dev/null 2>&1
		command -v "$bin" >/dev/null 2>&1 || { missing=1; log err "failed to install $pkg"; }
	done
	return $missing
}

# ---------------------------------------------------------------------------
# sync
# ---------------------------------------------------------------------------
cmd_sync() {
	load_cfg

	rm -rf "$TMPDIR"
	mkdir -p "$TMPDIR" || { log err "cannot create $TMPDIR"; return 1; }
	local links="$TMPDIR/links.txt"
	: > "$links"
	local ok=0 count=0 nosub=0

	if [ -z "$(printf '%s' "$URLS" | tr -d '[:space:]')" ]; then
		# нет ни одной подписки — это НЕ ошибка: чистим ноды подписки,
		# ручные сохраняем (links остаётся пустым)
		nosub=1
		log info "no subscription URLs — clearing managed nodes, keeping manual"
	else
		# зависимости (python3/curl) нужны только когда реально качаем/парсим
		if ! check_deps; then
			set_status "error" "Не удалось установить зависимости (python3-light/curl)" ""
			rm -rf "$TMPDIR"
			return 1
		fi

		# скачивание всех подписок; при ЛЮБОЙ ошибке — прерываем (fail-safe).
		# Каждая подписка — отдельный файл и отдельный парс (форматы разные).
		local parts="" i=0
		local OLDIFS="$IFS"; IFS='
'
		for url in $URLS; do
			[ -n "$url" ] || continue
			i=$((i + 1))
			local part="$TMPDIR/sub_$i.txt"
			if curl -fsS -A "$USER_AGENT" \
				--connect-timeout 10 --max-time 30 \
				-o "$part" "$url"; then
				parts="$parts $part"
				ok=$((ok + 1))
			else
				IFS="$OLDIFS"
				set_status "error" "Ошибка скачивания подписки: $url" ""
				log err "download failed, keeping current config: $url"
				rm -rf "$TMPDIR"
				return 1
			fi
		done
		IFS="$OLDIFS"

		# парсинг (все источники разом, глобальный дедуп/нумерация)
		local pflag=""
		[ "$DEDUP" = "0" ] && pflag="--all"
		if ! "$PYTHON" "$PARSER" $pflag $parts > "$links" 2>"$TMPDIR/err.log"; then
			set_status "error" "Ошибка парсера: $(cat "$TMPDIR/err.log")" ""
			log err "parser failed"
			rm -rf "$TMPDIR"
			return 1
		fi

		count=$(grep -c . "$links" 2>/dev/null || echo 0)
		if [ "$count" -eq 0 ]; then
			# подписка скачалась, но нод 0 (заглушка/битый ответ) — fail-safe,
			# конфиг НЕ трогаем (в отличие от осознанного «нет подписок»)
			set_status "error" "Парсер не вернул ни одной ноды (конфиг не изменён)" "0"
			log warn "0 nodes parsed, keeping current config"
			rm -rf "$TMPDIR"
			return 1
		fi
	fi

	# --- «наши» ноды: ручные из поля manual_nodes + ноды подписки ------------
	local ourlinks="$TMPDIR/our.txt"
	: > "$ourlinks"
	local mcount=0
	# ручные ноды: по одной vless:// в строке, пробелы обрезаем, мусор пропускаем
	printf '%s' "$MANUAL" | tr -d '\r' > "$TMPDIR/manual_raw.txt"
	while IFS= read -r ml || [ -n "$ml" ]; do
		ml=$(printf '%s' "$ml" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		case "$ml" in
			vless://*) printf '%s\n' "$ml" >> "$ourlinks"; mcount=$((mcount + 1)) ;;
		esac
	done < "$TMPDIR/manual_raw.txt"
	# ноды подписки
	cat "$links" >> "$ourlinks"
	# убрать точные дубли внутри наших нод (ручные vs подписка), ручные важнее
	: > "$TMPDIR/our_d.txt"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		grep -qxF "$line" "$TMPDIR/our_d.txt" && continue
		printf '%s\n' "$line" >> "$TMPDIR/our_d.txt"
	done < "$ourlinks"
	mv "$TMPDIR/our_d.txt" "$ourlinks"

	# --- запись в podkop -------------------------------------------------
	local mf="$(managed_file "$SECTION")"
	local keep="$TMPDIR/keep.txt"
	: > "$keep"
	local kept=0

	if [ "$PRESERVE" = "1" ]; then
		# сохраняем ноды секции, добавленные НЕ нами (внешние — напрямую в podkop).
		# Реестр хранит наши прошлые ссылки; чего нет ни в реестре, ни в наших
		# текущих нодах — считаем внешним и сохраняем.
		for l in $(uci -q get "podkop.$SECTION.urltest_proxy_links" 2>/dev/null); do
			[ -f "$mf" ] && grep -qxF "$l" "$mf" && continue
			grep -qxF "$l" "$ourlinks" && continue
			printf '%s\n' "$l" >> "$keep"; kept=$((kept + 1))
		done
	fi

	uci -q delete "podkop.$SECTION.urltest_proxy_links"
	while IFS= read -r line; do
		[ -n "$line" ] && uci add_list "podkop.$SECTION.urltest_proxy_links=$line"
	done < "$keep"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		grep -qxF "$line" "$keep" && continue
		uci add_list "podkop.$SECTION.urltest_proxy_links=$line"
	done < "$ourlinks"

	if ! uci commit podkop; then
		set_status "error" "Не удалось сохранить podkop (uci commit)" ""
		log err "uci commit podkop failed"
		uci -q revert podkop
		rm -rf "$TMPDIR"
		return 1
	fi

	# реестр = наши ноды (ручные из поля + подписка)
	mkdir -p "$MANAGED_DIR"
	cp "$ourlinks" "$mf"

	podkop reload >/dev/null 2>&1 || podkop restart >/dev/null 2>&1

	local total=$((count + mcount + kept))
	if [ "$nosub" = 1 ]; then
		set_status "ok" "Без подписки. Вручную: $mcount, внешних: $kept, всего: $total" "$total"
	else
		set_status "ok" "Из подписки: $count, вручную: $mcount, внешних: $kept, всего: $total" "$total"
	fi
	log info "sync ok: sub=$count manual=$mcount external=$kept total=$total in '$SECTION'"
	rm -rf "$TMPDIR"
	return 0
}

# ---------------------------------------------------------------------------
# update_cron — задача в /etc/crontabs/root по маркеру, без дублирования
# ---------------------------------------------------------------------------
cmd_update_cron() {
	config_load podkop_sub
	config_get ENABLED config enabled "1"
	config_get CRON    config cron    "0"

	local schedule=""
	# при выключенном сервисе задачу снимаем независимо от расписания
	if [ "$ENABLED" = "1" ]; then
		case "$CRON" in
			6)  schedule="0 */6 * * *" ;;
			12) schedule="0 */12 * * *" ;;
			24) schedule="0 4 * * *" ;;
			*)  schedule="" ;;   # 0 / off / прочее — задача удаляется
		esac
	fi

	mkdir -p "$(dirname "$CRON_FILE")"
	touch "$CRON_FILE"
	# удалить прежнюю строку с маркером
	local tmp="$CRON_FILE.tmp.$$"
	grep -v "$CRON_MARK" "$CRON_FILE" > "$tmp" 2>/dev/null
	mv "$tmp" "$CRON_FILE"

	if [ -n "$schedule" ]; then
		echo "$schedule /usr/libexec/podkop_sub_service sync >/dev/null 2>&1 $CRON_MARK" >> "$CRON_FILE"
		log info "cron set: $schedule"
	else
		log info "cron disabled"
	fi

	/etc/init.d/cron enable  >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# status — JSON для UI: статус + разобранные ноды выбранной секции
# ---------------------------------------------------------------------------
cmd_status() {
	config_load podkop_sub
	config_get SECTION config section "main"
	local st ms up
	config_get st  config last_status  ""
	config_get ms  config last_message ""
	config_get up  config last_update  "0"

	# Собираем ноды секции и считаем РЕАЛЬНОЕ количество (а не сохранённое
	# last_count) — так счётчик всегда совпадает с таблицей.
	# uci get для списка отдаёт элементы через пробел; в наших ссылках
	# пробелов нет (фрагмент полностью percent-encoded), поэтому split безопасен.
	# Разбор ссылки на имя/протокол/хост/порт делает main.js (decodeURIComponent).
	local nodes_json="" cnt=0 link
	for link in $(uci -q get "podkop.$SECTION.urltest_proxy_links" 2>/dev/null); do
		case "$link" in
			vless://*) ;;
			*) continue ;;
		esac
		[ -n "$nodes_json" ] && nodes_json="$nodes_json,"
		nodes_json="$nodes_json\"$(printf '%s' "$link" | json_escape)\""
		cnt=$((cnt + 1))
	done

	printf '{"status":"%s","message":"%s","last_update":%s,"count":%s,"section":"%s","nodes":[%s]}\n' \
		"$(printf '%s' "$st" | json_escape)" \
		"$(printf '%s' "$ms" | json_escape)" \
		"${up:-0}" "$cnt" "$(printf '%s' "$SECTION" | json_escape)" \
		"$nodes_json"
}

# ---------------------------------------------------------------------------
# sections — JSON-массив имён секций из /etc/config/podkop
# ---------------------------------------------------------------------------
cmd_sections() {
	local first=1
	printf '['
	config_load podkop
	# секции типа 'section' — это цели podkop
	for s in $(uci -q show podkop | sed -n "s/^podkop\.\([^.=]*\)=section$/\1/p"); do
		[ $first -eq 0 ] && printf ','
		first=0
		printf '"%s"' "$(printf '%s' "$s" | json_escape)"
	done
	printf ']\n'
}

# ---------------------------------------------------------------------------
case "$1" in
	sync)        cmd_sync ;;
	update_cron) cmd_update_cron ;;
	status)      cmd_status ;;
	sections)    cmd_sections ;;
	check_deps)  check_deps ;;
	*)
		echo "usage: $0 {sync|update_cron|status|sections|check_deps}" >&2
		exit 1
		;;
esac
