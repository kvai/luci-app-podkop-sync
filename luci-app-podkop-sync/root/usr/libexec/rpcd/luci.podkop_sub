#!/bin/sh
# rpcd-провайдер ubus-объекта luci.podkop_sub для фронтенда LuCI.
# Тонкая обёртка над /usr/libexec/podkop_sub_service — вся логика там.

SVC="/usr/libexec/podkop_sub_service"

case "$1" in
	list)
		# объявляем методы (без обязательных аргументов — конфиг читается из UCI)
		echo '{ "sync": {}, "status": {}, "update_cron": {} }'
		;;
	call)
		case "$2" in
			sync)
				# Синхронизация идёт отдельным процессом: с перезапуском podkop и
				# возможным откатом она может длиться дольше таймаута rpcd, а оборванный
				# на середине sync оставил бы сеть лежать. Ждём её до 25 секунд и
				# отдаём статус; если не успела — в статусе будет "running": true.
				# «force»: человек нажал кнопку, память об отвергнутом наборе не мешает.
				( "$SVC" sync force >/dev/null 2>&1 & )
				sleep 1
				i=0
				while [ $i -lt 24 ] && [ -d /tmp/podkop_sub.lock ]; do
					sleep 1
					i=$((i + 1))
				done
				"$SVC" status
				;;
			status)
				"$SVC" status
				;;
			update_cron)
				"$SVC" update_cron >/dev/null 2>&1
				echo '{ "ok": true }'
				;;
			*)
				echo '{ "error": "unknown method" }'
				;;
		esac
		;;
esac
