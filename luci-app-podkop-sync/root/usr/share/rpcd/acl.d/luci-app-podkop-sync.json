{
	"luci-app-podkop-sync": {
		"description": "Grant access to Podkop Sync",
		"read": {
			"ubus": {
				"luci.podkop_sub": [ "status" ]
			},
			"uci": [ "podkop_sub", "podkop" ]
		},
		"write": {
			"ubus": {
				"luci.podkop_sub": [ "sync", "update_cron" ]
			},
			"uci": [ "podkop_sub" ]
		}
	}
}
