#!/bin/sh
# podkop_sub_service — бэкенд синхронизации подписок для podkop.
#
# Команды:
#   sync            Скачать подписки, распарсить и записать ноды в podkop (fail-safe).
#   update_cron     Пересобрать задачу cron по значению podkop_sub.config.cron.
#   status          Вывести JSON со статусом последнего обновления и списком нод.
#   sections        Вывести JSON-массив секций /etc/config/podkop (для UI).
#
# Безопасность: все временные файлы — только в /tmp (tmpfs). Рабочий
# /etc/config/podkop НЕ трогается, если скачивание упало или парсер вернул 0 нод.

# PODKOP_SUB_ROOT / PODKOP_SUB_PATH задаются только в тестах (tests/test_sync.py):
# на роутере они пусты и все пути абсолютные.
ROOT="${PODKOP_SUB_ROOT:-}"
# Версия плагина (показывается в LuCI). Должна совпадать с PKG_VERSION в
# Makefile — за этим следит tests/test_sync.py.
VERSION="1.2.1"
# Номер сборки: GitHub Actions подставляет сюда и в PKG_RELEASE порядковый номер
# запуска, чтобы каждая сборка была «новее» предыдущей и opkg обновлял пакет
# поверх без удаления. «dev» — файлы выложены вручную (dev-deploy.sh).
RELEASE="dev"
. "$ROOT/lib/functions.sh"

# rpcd/cron запускают нас с урезанным PATH — задаём явно и резолвим python.
export PATH="${PODKOP_SUB_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"
PYTHON="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"

PARSER="$ROOT/usr/bin/podkop_sync.py"
# не TMPDIR: это стандартная переменная окружения, её читают дочерние процессы
WORK="$ROOT/tmp/podkop_sub"
LOCK="$ROOT/tmp/podkop_sub.lock"
CRON_FILE="$ROOT/etc/crontabs/root"
CRON_MARK="# podkop_sub_sync"

log() { logger -t podkop_sub -p "daemon.$1" "$2"; }

json_escape() {
	# экранирование строки для JSON
	sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' \
		-e ':a;N;$!ba;s/\n/\\n/g'
}

# число непустых строк файла (grep -c сам печатает 0, «|| echo 0» давало «0\n0»)
count_lines() {
	local n
	n=$(grep -c . "$1" 2>/dev/null)
	echo "${n:-0}"
}

# --- запись статуса в /etc/config/podkop_sub -------------------------------
set_status() {
	# $1=status  $2=message  [$3=count]
	uci -q set podkop_sub.config.last_status="$1"
	uci -q set podkop_sub.config.last_message="$2"
	uci -q set podkop_sub.config.last_update="$(date +%s)"
	[ -n "$3" ] && uci -q set podkop_sub.config.last_count="$3"
	uci -q commit podkop_sub
}

# --- чтение конфигурации плагина -------------------------------------------
URLS=""
add_url() { [ -n "$1" ] && URLS="$URLS
$1"; }

load_cfg() {
	config_load podkop_sub
	config_get ENABLED      config enabled         "1"
	config_get SECTION      config section         "main"
	config_get DEDUP        config deduplicate      "1"
	config_get PRESERVE     config preserve_manual  "1"
	config_get STICKY       config sticky          "1"
	config_get CRON         config cron            "24"
	config_get USER_AGENT   config user_agent      "v2rayNG/1.9.5"
	config_get MANUAL       config manual_nodes    ""
	config_list_foreach config url add_url
}

# Текущие ссылки секции podkop — по одной в строке. Через config_list_foreach,
# а не `for l in $(uci get …)`: uci берёт элементы с пробелом в кавычки, и
# разбиение по пробелам рвало бы такую ссылку на куски.
CUR_FILE=""
cur_add() { printf '%s\n' "$1" >> "$CUR_FILE"; }
read_current_links() {
	# $1=секция  $2=файл
	CUR_FILE="$2"
	: > "$CUR_FILE"
	config_load podkop
	config_list_foreach "$1" urltest_proxy_links cur_add
}

# каталог реестра «управляемых» ссылок (что плагин добавил в прошлый раз),
# по файлу на секцию — чтобы при обновлении сносить только свои ноды.
MANAGED_DIR="$ROOT/etc/podkop_sub.managed.d"
managed_file() { echo "$MANAGED_DIR/$1"; }
# Источники нод: строки «N<TAB>ссылка», где N — номер подписки (с 1), 0 — ручная
# нода из поля плагина. Внешних нод (добавленных прямо в podkop) в файле нет.
# Файл читают другие инструменты (например, проба доступности): по нему видно,
# какие ноды «свои» (первая подписка), а какие из дополнительных подписок.
origins_file() { echo "$MANAGED_DIR/$1.origins"; }

# Положить реестр и источники на место (через временные файлы).
store_registry() {
	# $1 = секция, $2 = файл реестра (наши ссылки), $3 = файл источников
	local mf="$(managed_file "$1")" of="$(origins_file "$1")"
	mkdir -p "$MANAGED_DIR" || return 1
	cp "$2" "$mf.tmp" && mv "$mf.tmp" "$mf" || return 1
	cp "$3" "$of.tmp" && mv "$of.tmp" "$of" || return 1
}

# Менеджер пакетов системы: apk (OpenWrt 25.12+) или opkg (24.10 и старше).
pkg_manager() {
	if command -v apk >/dev/null 2>&1 && [ -d "$ROOT/lib/apk/db" ]; then echo apk
	elif command -v opkg >/dev/null 2>&1; then echo opkg
	fi
}

# Проверка зависимостей: если бинарь есть — пропускаем; если нет — ставим
# менеджером пакетов системы (актуально для ручной/git-установки; у пакета
# зависимости уже подтянуты). Список пар "пакет:бинарь". Возвращает 1, если
# что-то не удалось.
check_deps() {
	local pair pkg bin updated=0 missing=0 pm
	pm="$(pkg_manager)"
	for pair in python3-light:python3 curl:curl; do
		pkg="${pair%%:*}"; bin="${pair##*:}"
		command -v "$bin" >/dev/null 2>&1 && continue
		log warn "dependency '$bin' ($pkg) not found — installing via ${pm:-?}"
		case "$pm" in
			apk)
				if [ "$updated" = 0 ]; then apk update >/dev/null 2>&1; updated=1; fi
				apk add "$pkg" >/dev/null 2>&1
				;;
			opkg)
				if [ "$updated" = 0 ]; then opkg update >/dev/null 2>&1; updated=1; fi
				opkg install "$pkg" >/dev/null 2>&1
				;;
		esac
		command -v "$bin" >/dev/null 2>&1 || { missing=1; log err "failed to install $pkg"; }
	done
	return $missing
}

# Установлен ли сам podkop: без него некуда писать ноды и нечего перезапускать.
podkop_installed() {
	command -v podkop >/dev/null 2>&1 && [ -x "$ROOT/etc/init.d/podkop" ]
}

# Состояние выходов sing-box (работает/нет) — из его Clash API, который включает
# podkop (YACD). Нужен для закрепления SNI/short id у работающих нод. Если API
# недоступен, файла не будет, и закрепление просто не применяется.
fetch_health() {
	# $1 = куда сохранить
	local cfgp ctl secret
	cfgp="$(uci -q get podkop.settings.config_path 2>/dev/null)"
	[ -n "$cfgp" ] || cfgp="/etc/sing-box/config.json"
	ctl="$(jsonfilter -i "$ROOT$cfgp" -e '@.experimental.clash_api.external_controller' 2>/dev/null)"
	[ -n "$ctl" ] || return 1
	secret="$(jsonfilter -i "$ROOT$cfgp" -e '@.experimental.clash_api.secret' 2>/dev/null)"
	if [ -n "$secret" ]; then
		curl -fsS --max-time 5 -H "Authorization: Bearer $secret" -o "$1" -- "http://$ctl/proxies" 2>/dev/null
	else
		curl -fsS --max-time 5 -o "$1" -- "http://$ctl/proxies" 2>/dev/null
	fi
}

# Транспорты, с которыми podkop умеет работать. Нода с неизвестным транспортом
# опасна: podkop сначала останавливается (снимает nft и sing-box, а с ним и DNS
# всей сети) и только потом обнаруживает, что конфиг собрать не может.
# tcp/raw/ws/grpc podkop разбирает сам; xhttp — только если установленный
# sing-box умеет «tools decode-link» (podkop-engine), это видно в его features.
supported_transports() {
	local t="tcp,raw,ws,grpc"
	podkop get_sing_box_features 2>/dev/null | grep -q 'tools\.decode-link' && t="$t,xhttp,splithttp"
	echo "$t"
}

# Отпечаток окружения podkop: по нему решаем, имеет ли смысл повторять набор
# нод, который podkop уже отверг (после обновления podkop/sing-box — имеет).
podkop_fingerprint() {
	echo "$(podkop show_version 2>/dev/null | head -n 1)|$(podkop get_sing_box_features 2>/dev/null | tr -d ' \n')"
}

# Набор нод без того, что меняется от скачивания к скачиванию (имя, SNI,
# short id): для сравнения «это тот же набор, что уже был отвергнут».
stable_signature() {
	sed -e 's/#.*$//' -e 's/[?&]sni=[^&]*//' -e 's/[?&]sid=[^&]*//' "$1" | sort -u
}

# Записать список ссылок из файла в секцию podkop и закоммитить.
write_links() {
	# $1 = секция, $2 = файл со ссылками
	local line werr=0
	uci -q delete "podkop.$1.urltest_proxy_links"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		uci add_list "podkop.$1.urltest_proxy_links=$line" || werr=1
	done < "$2"
	if [ "$werr" = 1 ] || ! uci commit podkop; then
		uci -q revert podkop
		return 1
	fi
	return 0
}

# --- блокировка от параллельных запусков (cron + кнопка, двойной клик) ------
# mkdir атомарен; если владелец блокировки уже умер — считаем её брошенной.
acquire_lock() {
	if ! mkdir "$LOCK" 2>/dev/null; then
		local pid
		pid=$(cat "$LOCK/pid" 2>/dev/null)
		# владелец мог только что создать каталог и ещё не записать pid
		[ -n "$pid" ] || { sleep 1; pid=$(cat "$LOCK/pid" 2>/dev/null); }
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			return 1
		fi
		rm -rf "$LOCK"
		mkdir "$LOCK" 2>/dev/null || return 1
	fi
	echo $$ > "$LOCK/pid"
	return 0
}
release_lock() { rm -rf "$LOCK"; }

# Набор нод без имён (#фрагмент) и без учёта порядка: podkop имя ноды не
# использует, поэтому перезапуск нужен, только если изменился этот набор.
# Публичный ключ, SNI, short id, адрес и порт — часть ссылки ДО «#», так что
# их смена всегда считается изменением.
links_signature() { sed 's/#.*$//' "$1" | sort -u; }

# ---------------------------------------------------------------------------
# sync
# ---------------------------------------------------------------------------
FORCE=0
cmd_sync() {
	# «force» передаёт кнопка в LuCI: человек сам просит попробовать ещё раз,
	# поэтому память об отвергнутом наборе игнорируется. Cron зовёт без него.
	[ "$1" = "force" ] && FORCE=1
	if ! acquire_lock; then
		log warn "sync is already running — skipped"
		return 2
	fi
	trap 'release_lock; rm -rf "$WORK"' EXIT
	trap 'exit 1' INT TERM
	do_sync
}

do_sync() {
	load_cfg

	# (0) без podkop делать нечего — говорим об этом прямо, а не «секция не найдена»
	if ! podkop_installed; then
		set_status "error" "Podkop не установлен — синхронизация невозможна. Установите Podkop и нажмите «Обновить сейчас»." ""
		log err "podkop is not installed"
		return 1
	fi

	# (2) целевая секция должна существовать в podkop
	if [ -z "$(uci -q get "podkop.$SECTION" 2>/dev/null)" ]; then
		set_status "error" "Секция '$SECTION' не найдена в podkop" ""
		log err "target section '$SECTION' does not exist"
		return 1
	fi
	# (1) режим секции: не URLTest — пишем, но предупреждаем (podkop их не читает)
	local secwarn="" is_urltest=1
	if [ "$(uci -q get "podkop.$SECTION.proxy_config_type" 2>/dev/null)" != "urltest" ]; then
		is_urltest=0
		secwarn="⚠ Секция '$SECTION' не в режиме URLTest — podkop не использует эти ноды. "
		log warn "section '$SECTION' is not urltest; nodes written but ignored by podkop"
	fi

	rm -rf "$WORK"
	mkdir -p "$WORK" || { log err "cannot create $WORK"; return 1; }
	local links="$WORK/links.txt"
	: > "$links"
	local count=0 nosub=0 persub="" stuck=0 trnote="" mtr=0 deadn=0 newsni=0
	local transports="$(supported_transports)"
	# что сейчас записано в секции podkop (нужно и для закрепления, и для сравнения)
	local cur="$WORK/cur.txt"
	read_current_links "$SECTION" "$cur"

	if [ -z "$(printf '%s' "$URLS" | tr -d '[:space:]')" ]; then
		# нет ни одной подписки — это НЕ ошибка: чистим ноды подписки,
		# ручные сохраняем (links остаётся пустым)
		nosub=1
		log info "no subscription URLs — clearing managed nodes, keeping manual"
	else
		# зависимости (python3/curl) нужны только когда реально качаем/парсим
		if ! check_deps; then
			set_status "error" "Не удалось установить зависимости (python3-light/curl)" ""
			return 1
		fi

		# Скачиваем каждую подписку отдельно и считаем ноды по каждой. В persub —
		# сводка по каждой (для UI: понятно, какая в ауте). URL в лог не пишем:
		# в нём токен подписки.
		local parts="" ok=0 failed=0 i=0 c
		local OLDIFS="$IFS"; IFS='
'
		for url in $URLS; do
			[ -n "$url" ] || continue
			i=$((i + 1))
			local part="$WORK/sub_$i.txt"
			case "$url" in
				http://*|https://*) ;;
				*)
					# не URL: строка с «-» стала бы опцией curl, file:// читал бы файлы
					persub="$persub #$i=плохой_URL"; failed=$((failed + 1))
					log err "subscription #$i: not an http(s) URL"
					continue ;;
			esac
			if curl -fsSL --max-redirs 3 --proto '=http,https' --proto-redir '=http,https' \
				--max-filesize 2097152 -A "$USER_AGENT" \
				--connect-timeout 10 --max-time 30 -o "$part" -- "$url"; then
				c=$("$PYTHON" "$PARSER" --transports "$transports" "$part" 2>"$WORK/sub_$i.err" | grep -c .)
				c="${c:-0}"
				if [ "$c" -gt 0 ]; then
					parts="$parts $part"; ok=$((ok + 1)); persub="$persub #$i=$c"
				elif grep -q '^Пропущено из-за транспорта' "$WORK/sub_$i.err" 2>/dev/null; then
					# ноды есть, но все с транспортом, которого podkop не умеет: это не
					# сбой подписки, остальные подписки из-за неё блокировать нельзя
					parts="$parts $part"; ok=$((ok + 1))
					persub="$persub #$i=0(транспорт не поддерживается)"
					log warn "subscription #$i: all nodes use unsupported transports"
				else
					persub="$persub #$i=0(пусто)"; failed=$((failed + 1))
					log warn "subscription #$i returned 0 usable nodes"
				fi
			else
				persub="$persub #$i=нет_сети"; failed=$((failed + 1))
				log err "subscription #$i download failed"
			fi
		done
		IFS="$OLDIFS"

		# Fail-safe: если хоть одна подписка не скачалась или пуста — конфиг НЕ
		# трогаем. Иначе ноды временно недоступной подписки были бы удалены.
		if [ "$failed" -gt 0 ] || [ "$ok" -eq 0 ]; then
			set_status "error" "Подписки не обновлены:$persub (конфиг не изменён)" ""
			log warn "subscription failed/empty, keeping current config"
			return 1
		fi

		# итоговый разбор рабочих подписок (глобальный дедуп/нумерация)
		local pflag=""
		[ "$DEDUP" = "0" ] && pflag="--all"
		# у работающих нод оставляем прежние SNI и short id (см. podkop_sync.py)
		local sflag=""
		if [ "$STICKY" = "1" ] && fetch_health "$WORK/proxies.json"; then
			sflag="--stick $cur --health $WORK/proxies.json --section $SECTION --dead-out $WORK/dead.txt"
			# Ноды, которые не работали и в прошлый раз (им уже выдавали свежие SNI и
			# short id), повторно не трогаем — иначе лежащая нода меняла бы список при
			# каждой синхронизации. По кнопке (force) ещё раз пробуем обновить только
			# «свои» ноды (первая подписка); чужие лежащие серверы не трогаем.
			[ -f "$MANAGED_DIR/$SECTION.dead" ] && sflag="$sflag --frozen $MANAGED_DIR/$SECTION.dead"
			[ "$FORCE" = 1 ] && sflag="$sflag --retry-own"
			# sing-box запущен совсем недавно и ещё не успел проверить ноды: пустая
			# история сейчас значит «нет данных», а не «нода не работает»
			singbox_is_fresh && sflag="$sflag --assume-working"
			# Первую подписку скачиваем ещё три раза: если все скачивания дают ноде одно
			# и то же имя SNI, значит в списке на сервере только оно — применяем его,
			# даже если прежнее ещё работает (иначе выбранное владельцем имя не
			# применилось бы, пока старое не сломается).
			local k first="" su
			for su in $URLS; do [ -n "$su" ] && { first="$su"; break; }; done
			case "$first" in
				http://*|https://*)
					for k in 2 3 4; do
						curl -fsSL --max-redirs 3 --proto '=http,https' --proto-redir '=http,https' \
							--max-filesize 2097152 -A "$USER_AGENT" --connect-timeout 10 --max-time 20 \
							-o "$WORK/sample_$k.txt" -- "$first" 2>/dev/null \
							&& sflag="$sflag --sample $WORK/sample_$k.txt"
					done ;;
			esac
		fi
		if ! "$PYTHON" "$PARSER" --transports "$transports" --origins "$WORK/origins.sub" $pflag $sflag $parts > "$links" 2>"$WORK/err.log"; then
			set_status "error" "Ошибка парсера: $(tail -n 1 "$WORK/err.log")" ""
			log err "parser failed"
			return 1
		fi
		count=$(count_lines "$links")
		stuck=$(sed -n 's/^Закреплено нод: //p' "$WORK/err.log")
		case "$stuck" in ''|*[!0-9]*) stuck=0 ;; esac
		trnote=$(sed -n 's/^Пропущено из-за транспорта: //p' "$WORK/err.log" | head -n 1)
		newsni=$(sed -n 's/^Принято новых SNI: //p' "$WORK/err.log" | head -n 1)
		case "$newsni" in ''|*[!0-9]*) newsni=0 ;; esac
		# запоминаем, какие ноды сейчас не работают (на flash пишем, только если изменилось)
		if [ -f "$WORK/dead.txt" ]; then
			cmp -s "$WORK/dead.txt" "$MANAGED_DIR/$SECTION.dead" 2>/dev/null \
				|| { mkdir -p "$MANAGED_DIR" && cp "$WORK/dead.txt" "$MANAGED_DIR/$SECTION.dead"; }
			deadn=$(count_lines "$WORK/dead.txt")
		fi
	fi

	# --- «наши» ноды: ручные из поля manual_nodes + ноды подписки ------------
	local ourlinks="$WORK/our.txt"
	: > "$ourlinks"
	local mcount=0 mskip=0 mt
	# ручные ноды: по одной vless:// в строке. Обрезаем пробелы по краям; строки
	# с пробелом ВНУТРИ ссылки пропускаем (незакодированный фрагмент сломал бы
	# разбор ссылки в podkop).
	printf '%s' "$MANUAL" | tr -d '\r' > "$WORK/manual_raw.txt"
	while IFS= read -r ml || [ -n "$ml" ]; do
		ml=$(printf '%s' "$ml" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		case "$ml" in
			vless://*)
				case "$ml" in
					*[[:space:]]*)
						mskip=$((mskip + 1))
						log warn "manual node with internal space skipped (encode the #name)" ;;
					*)
						# ручные ноды парсер не проходят — транспорт проверяем здесь,
						# по тому же белому списку (нет type= значит tcp)
						mt=$(printf '%s' "${ml%%#*}" | sed -n 's/.*[?&]type=\([^&]*\).*/\1/p')
						[ -n "$mt" ] || mt="tcp"
						case ",$transports," in
							*",$mt,"*) printf '%s\n' "$ml" >> "$ourlinks"; printf '%s\n' "$ml" >> "$WORK/manual_ok.txt"
							   mcount=$((mcount + 1)) ;;
							*) mtr=$((mtr + 1))
							   log warn "manual node skipped: transport '$mt' is not supported by podkop" ;;
						esac ;;
				esac ;;
		esac
	done < "$WORK/manual_raw.txt"
	# ноды подписки
	cat "$links" >> "$ourlinks"
	# убрать точные дубли внутри наших нод (ручные vs подписка), ручные важнее
	: > "$WORK/our_d.txt"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		grep -qxF -- "$line" "$WORK/our_d.txt" && continue
		printf '%s\n' "$line" >> "$WORK/our_d.txt"
	done < "$ourlinks"
	mv "$WORK/our_d.txt" "$ourlinks"
	# источники для итогового набора: ручные — 0, остальные — номер подписки
	local origins="$WORK/origins.txt" tab="$(printf '\t')"
	: > "$origins"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		if [ -f "$WORK/origins.sub" ] && grep -qF -- "$tab$line" "$WORK/origins.sub" && ! grep -qxF -- "$line" "$WORK/manual_ok.txt" 2>/dev/null; then
			grep -F -- "$tab$line" "$WORK/origins.sub" | head -n 1 >> "$origins"
		else
			printf '0\t%s\n' "$line" >> "$origins"
		fi
	done < "$ourlinks"

	# --- что сейчас в podkop и что должно получиться -----------------------
	local mf="$(managed_file "$SECTION")"
	local keep="$WORK/keep.txt" new="$WORK/new.txt"
	: > "$keep"
	local kept=0

	if [ "$PRESERVE" = "1" ]; then
		# сохраняем ноды секции, добавленные НЕ нами (внешние — напрямую в podkop).
		# Реестр хранит наши прошлые ссылки; чего нет ни в реестре, ни в наших
		# текущих нодах — считаем внешним и сохраняем.
		while IFS= read -r l; do
			[ -n "$l" ] || continue
			[ -f "$mf" ] && grep -qxF -- "$l" "$mf" && continue
			grep -qxF -- "$l" "$ourlinks" && continue
			printf '%s\n' "$l" >> "$keep"; kept=$((kept + 1))
		done < "$cur"
	fi

	cp "$keep" "$new"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		grep -qxF -- "$line" "$keep" && continue
		printf '%s\n' "$line" >> "$new"
	done < "$ourlinks"

	local total=$((count + mcount + kept))
	# сводка ручных: сколько пропущено из-за пробелов
	local mnote=""
	[ "$mskip" -gt 0 ] && mnote=" (пропущено ручных с пробелом: $mskip)"
	[ "$mtr" -gt 0 ] && mnote="$mnote (пропущено ручных с неподдерживаемым транспортом: $mtr)"
	local summary
	if [ "$nosub" = 1 ]; then
		summary="Без подписки. Вручную: $mcount, внешних: $kept, всего: $total$mnote"
	else
		summary="Подписки:$persub · вручную: $mcount, внешних: $kept, всего: $total$mnote"
		[ "$stuck" -gt 0 ] && summary="$summary · SNI/short id сохранены у работающих: $stuck"
		[ -n "$trnote" ] && summary="$summary · не поддерживаются podkop и пропущены: $trnote"
		[ "$deadn" -gt 0 ] && summary="$summary · не отвечают: $deadn"
		[ "$newsni" -gt 0 ] && summary="$summary · приняты новые SNI с сервера: $newsni"
	fi
	# статус warn, если секция не в режиме URLTest
	local slvl="ok"
	[ -n "$secwarn" ] && slvl="warn"

	# Пустой список в podkop писать нельзя: с ним podkop не стартует вовсе.
	if [ "$(count_lines "$new")" -eq 0 ]; then
		set_status "error" "Итоговый список нод пуст (конфиг не изменён). $summary" ""
		log warn "resulting node list is empty, keeping current config"
		return 1
	fi

	# Ничего не изменилось — podkop не трогаем вовсе (ни записи, ни перезапуска).
	if cmp -s "$cur" "$new"; then
		# Реестр всё равно сверяем: нода могла «переехать» из внешних в поле ручных
		# (список в podkop тот же, а владелец ноды сменился).
		{ cmp -s "$ourlinks" "$mf" 2>/dev/null && cmp -s "$origins" "$(origins_file "$SECTION")" 2>/dev/null; } \
			|| store_registry "$SECTION" "$ourlinks" "$origins"
		uci -q set podkop_sub.config.last_sub="$count"
		uci -q set podkop_sub.config.last_manual="$((mcount + kept))"
		# список тот же, что уже стоит и работает, — прежний отказ неактуален
		rm -f "$MANAGED_DIR/$SECTION.rejected"
		local upnote=""
		if podkop_should_run "$is_urltest" && podkop_stopped; then
			upnote=" Podkop остановлен — не запускался."
			log info "podkop is stopped — not starting it"
		elif podkop_should_run "$is_urltest" && ! singbox_running; then
			# список не менялся, но sing-box не работает — поднимаем
			log warn "sing-box is not running — reloading podkop"
			if podkop reload >/dev/null 2>&1 && wait_singbox && ensure_dns; then
				upnote=" Podkop не работал — перезапущен."
			else
				set_status "error" "${secwarn}Список нод не менялся, но podkop не запускается — проверьте: logread -e podkop. $summary" "$total"
				return 1
			fi
		elif podkop_should_run "$is_urltest" && ! podkop_dns_active; then
			# sing-box работает, а DNS роутера идёт мимо него: трафик в VPN не попадает
			if ensure_dns; then
				upnote=" DNS роутера не был направлен на Podkop — выполнен полный перезапуск."
			else
				set_status "error" "${secwarn}Список нод не менялся, но DNS роутера не направлен на Podkop, и перезапуск не помог — выполните: service podkop restart. $summary" "$total"
				return 1
			fi
		fi
		set_status "$slvl" "${secwarn}Без изменений. $summary.$upnote" "$total"
		log info "sync ok: no changes ($total nodes) in '$SECTION'"
		return 0
	fi

	# Этот же набор нод podkop уже отверг (и сам podkop с тех пор не менялся) —
	# не роняем сеть повторно, например каждую ночь по cron. Отметка живёт
	# неделю; кнопка в LuCI (force) её игнорирует.
	local rejected="$MANAGED_DIR/$SECTION.rejected"
	[ -f "$rejected" ] && [ -n "$(find "$rejected" -mtime +7 2>/dev/null)" ] && rm -f "$rejected"
	if [ -f "$rejected" ] && [ "$FORCE" != 1 ]; then
		{ podkop_fingerprint; stable_signature "$new"; } > "$WORK/attempt.sig"
		if cmp -s "$WORK/attempt.sig" "$rejected"; then
			local rjnote="работает прежний список"
			if podkop_should_run "$is_urltest" && podkop_stopped; then
				rjnote="podkop остановлен"
			elif podkop_should_run "$is_urltest" && ! singbox_running; then
				log warn "sing-box is not running — reloading podkop with the current list"
				podkop reload >/dev/null 2>&1 && wait_singbox && ensure_dns \
					&& rjnote="podkop не работал и перезапущен на прежнем списке" \
					|| rjnote="podkop НЕ работает и на прежнем списке — проверьте: logread -e podkop"
			fi
			set_status "error" "${secwarn}Этот набор нод podkop уже отверг — повторно не применяю, $rjnote. Попробовать ещё раз: кнопка «Обновить сейчас». $summary" ""
			log warn "node set was already rejected by podkop — not applying again"
			return 1
		fi
	fi

	# --- проверка до применения -------------------------------------------
	# Собираем конфиг кодом самого podkop в стороне и проверяем его, ничего не
	# останавливая. Если podkop с этим списком не запустится — узнаём это сейчас,
	# а не после того, как он остановит sing-box и DNS. Нужна, только когда
	# перезапуск вообще предстоит.
	if [ "$(links_signature "$cur")" != "$(links_signature "$new")" ] && podkop_should_run "$is_urltest"; then
		local drc=0
		sh "$ROOT/usr/libexec/podkop_sub_dryrun" "$SECTION" "$new" "$WORK/dry.json" >/dev/null 2>&1 || drc=$?
		if [ "$drc" = 1 ]; then
			local dwhy
			dwhy=$(sed -n 's/^\[fatal\] //p' "$WORK/dry.json.log" 2>/dev/null | head -n 1 | cut -c1-160)
			[ -n "$dwhy" ] || dwhy=$(sed -e 's/\x1b\[[0-9;]*m//g' "$WORK/dry.json.err" 2>/dev/null | head -n 1 | cut -c1-160)
			set_status "error" "${secwarn}Podkop не сможет запуститься с этим набором нод — список НЕ изменён, VPN работает как прежде (проверено без перезапуска). Причина: ${dwhy:-не определена}. $summary" ""
			log warn "preflight: podkop would not start with the new nodes — nothing applied"
			return 1
		elif [ "$drc" != 0 ]; then
			# проверка недоступна (другая версия podkop) — остаётся откат после запуска
			log warn "preflight is not available (rc=$drc) — relying on rollback"
		fi
	fi

	# --- запись в podkop -------------------------------------------------
	# С этого места и до конца перезапуска/отката прерывать работу нельзя:
	# оборванный на середине sync оставил бы плохой список при лежащем podkop.
	trap '' INT TERM HUP
	# прежние реестр и источники сохраняем на случай отката
	[ -f "$mf" ] && cp "$mf" "$WORK/registry.old"
	[ -f "$(origins_file "$SECTION")" ] && cp "$(origins_file "$SECTION")" "$WORK/origins.old"
	if ! write_links "$SECTION" "$new"; then
		trap 'exit 1' INT TERM
		set_status "error" "Не удалось сохранить podkop (конфиг не изменён)" ""
		log err "writing podkop config failed"
		return 1
	fi

	# реестр = наши ноды (ручные из поля + подписка); через временный файл
	store_registry "$SECTION" "$ourlinks" "$origins" || log err "cannot update registry $mf"

	# --- перезапуск podkop: только если он действительно нужен -------------
	local rnote="" applied=1
	if [ "$(links_signature "$cur")" = "$(links_signature "$new")" ]; then
		rnote=" Изменились только имена или порядок — podkop не перезапускался."
		log info "only names/order changed — no podkop reload"
	elif [ "$is_urltest" = 0 ]; then
		rnote=""
	elif ! "$ROOT/etc/init.d/podkop" enabled >/dev/null 2>&1; then
		rnote=" Podkop выключен — не перезапускался."
		log info "podkop is disabled — no reload"
	elif podkop_stopped; then
		rnote=" Podkop остановлен — список записан и применится при запуске."
		log info "podkop is stopped — list written, not starting it"
	else
		# podkop reload = полная остановка и запуск (nft, sing-box, DNS).
		# Метка в логе: причину отказа ищем только среди строк после неё.
		local mark="reload-$$-$(date +%s)"
		logger -t podkop_sub "$mark"
		if podkop reload >/dev/null 2>&1 && wait_singbox; then
			rnote=" Podkop перезапущен."
			DNS_FIXED=0
			if ensure_dns; then
				[ "$DNS_FIXED" = 1 ] && rnote=" Podkop перезапущен полностью: DNS роутера не был направлен на него."
				rm -f "$rejected"
			else
				# ноды тут ни при чём, поэтому список не откатываем
				slvl="error"
				rnote=" Ноды записаны, но DNS роутера не направлен на Podkop, и перезапуск не помог — выполните: service podkop restart."
			fi
		else
			# Podkop не поднялся на новых нодах, а с ним лежит DNS всей сети.
			# Возвращаем прежний список.
			slvl="error"; applied=0
			local why
			why=$(logread 2>/dev/null | sed -n "/$mark/,\$p" | sed -n 's/.*podkop: \[fatal\] //p' | head -n 1 | cut -c1-160)
			[ -n "$why" ] && why=" Причина: $why"
			log err "podkop did not come up with the new nodes — rolling back"
			if [ "$(count_lines "$cur")" -eq 0 ]; then
				rnote=" Ноды записаны, но podkop не запустился, а вернуть нечего (прежний список был пуст) — проверьте: logread -e podkop.$why"
			elif ! write_links "$SECTION" "$cur" && ! write_links "$SECTION" "$cur"; then
				rnote=" Podkop не принял новые ноды, а вернуть прежний список не удалось (ошибка записи) — проверьте: logread -e podkop.$why"
				log err "rollback failed: cannot write the previous list"
			else
				if [ -f "$WORK/registry.old" ]; then cp "$WORK/registry.old" "$mf"; else rm -f "$mf"; fi
				if [ -f "$WORK/origins.old" ]; then cp "$WORK/origins.old" "$(origins_file "$SECTION")"; else rm -f "$(origins_file "$SECTION")"; fi
				total=$(count_lines "$cur")
				if podkop reload >/dev/null 2>&1 && wait_singbox && ensure_dns; then
					# Прежний список поднялся, новый — нет: значит, дело именно в новых
					# нодах. Только в этом случае запоминаем набор как отвергнутый.
					mkdir -p "$MANAGED_DIR" && { podkop_fingerprint; stable_signature "$new"; } > "$rejected"
					rnote=" Podkop НЕ принял новые ноды — возвращён прежний список ($total), VPN работает на нём.$why"
					log warn "rolled back to the previous $total nodes"
				else
					# Не поднялся и на прежнем: причина не в нодах (сеть, сам podkop).
					# Отказ НЕ запоминаем, чтобы следующий запуск попробовал снова.
					rnote=" Podkop не запустился ни на новых нодах, ни на прежних (возвращён прежний список) — проверьте: logread -e podkop.$why"
					log err "rollback did not bring podkop up"
				fi
			fi
		fi
	fi
	trap 'exit 1' INT TERM

	# счётчики для плиток — только если новый список действительно применён
	if [ "$applied" = 1 ]; then
		uci -q set podkop_sub.config.last_sub="$count"
		uci -q set podkop_sub.config.last_manual="$((mcount + kept))"
	fi
	set_status "$slvl" "${secwarn}$summary.$rnote" "$total"
	log info "sync done: sub=$count manual=$mcount external=$kept total=$total in '$SECTION' status=$slvl"
	[ "$slvl" = "error" ] && return 1
	return 0
}

singbox_running() { pidof sing-box >/dev/null 2>&1; }

# sing-box работает меньше трёх минут? (urltest проверяет ноды не мгновенно)
singbox_is_fresh() {
	local p up start
	p=$(pidof sing-box 2>/dev/null | cut -d' ' -f1)
	[ -n "$p" ] && [ -r "/proc/$p/stat" ] && [ -r /proc/uptime ] || return 1
	up=$(cut -d. -f1 /proc/uptime)
	start=$(cut -d' ' -f22 "/proc/$p/stat")
	[ $((up - start / 100)) -lt 180 ]
}

# Должен ли podkop сейчас работать: секция в режиме urltest и служба включена.
podkop_should_run() {
	[ "$1" = 1 ] && "$ROOT/etc/init.d/podkop" enabled >/dev/null 2>&1
}

# Направлен ли DNS роутера на sing-box. `podkop start` настраивает dnsmasq на
# 127.0.0.42, `podkop stop` возвращает прежние серверы, а `podkop reload` dnsmasq
# не трогает вовсе. С dont_touch_dhcp=1 podkop в dnsmasq не вмешивается — тогда
# по нему ничего сказать нельзя, считаем, что всё в порядке.
podkop_dns_active() {
	[ "$(uci -q get podkop.settings.dont_touch_dhcp 2>/dev/null)" = 1 ] && return 0
	uci -q get 'dhcp.@dnsmasq[0].server' 2>/dev/null | grep -q '127\.0\.0\.42'
}

# Podkop остановлен штатно (`service podkop stop`): sing-box не работает, и DNS
# возвращён провайдеру. Поднимать его через `podkop reload` нельзя: nft и sing-box
# запустятся, а DNS останется мимо — ноды «зелёные», а трафик в VPN не идёт.
# Упавший sing-box выглядит иначе: DNS по-прежнему смотрит на 127.0.0.42.
# Сам podkop помечает это флагом: `stop` пишет shutdown_correctly=1, `start` — 0,
# `reload` флаг не трогает. Флаг надёжнее DNS (он есть и при dont_touch_dhcp=1);
# по DNS судим, только если флага нет вовсе.
podkop_stopped() {
	singbox_running && return 1
	case "$(uci -q get podkop.settings.shutdown_correctly 2>/dev/null)" in
		1) return 0 ;;
		0) return 1 ;;
	esac
	! podkop_dns_active
}

# DNS обязан смотреть на sing-box. Если нет (podkop подняли наполовину) — делаем
# полный перезапуск службы: он настраивает dnsmasq. Запуск идёт под procd в фоне,
# поэтому ждём и sing-box, и сам DNS. 0 — DNS в порядке (DNS_FIXED=1, если для
# этого понадобился перезапуск), 1 — направить DNS на podkop не удалось.
ensure_dns() {
	podkop_dns_active && return 0
	log warn "dnsmasq does not point to sing-box — full podkop restart"
	"$ROOT/etc/init.d/podkop" restart >/dev/null 2>&1
	wait_singbox 40 || return 1
	local i=0
	while [ $i -lt 20 ]; do
		podkop_dns_active && { DNS_FIXED=1; return 0; }
		sleep 1
		i=$((i + 1))
	done
	log err "dnsmasq still does not point to sing-box after the restart"
	return 1
}

# Куда сейчас уходит трафик сети — для плитки «Статус» в интерфейсе:
#   podkop  — DNS роутера отвечает поддельными адресами sing-box: трафик идёт через Podkop
#   direct  — sing-box работает, но DNS идёт мимо него: трафик идёт напрямую, мимо VPN
#   down    — Podkop должен работать, а sing-box не запущен
#   stopped — Podkop остановлен штатно
#   none    — Podkop не установлен
# Проверка настоящая: спрашиваем у dnsmasq служебное имя Podkop и смотрим, вернулся ли
# адрес из диапазона FakeIP (198.18.0.0/15). Так же проверяет себя диагностика Podkop.
route_state() {
	podkop_installed || { echo none; return; }
	podkop_stopped && { echo stopped; return; }
	singbox_running || { echo down; return; }
	case "$(nslookup -timeout=2 fakeip.podkop.fyi 127.0.0.1 2>/dev/null | sed -n 's/^Address[^:]*: *\(198\.1[89]\.[0-9.]*\).*/\1/p' | head -n 1)" in
		198.18.*|198.19.*) echo podkop ;;
		*) echo direct ;;
	esac
}

# sing-box должен подняться после reload и НЕ упасть сразу: считаем его живым,
# только когда три проверки подряд (с интервалом в секунду) видят один и тот же
# процесс. Иначе procd-перезапуск падающего sing-box выглядел бы как успех.
wait_singbox() {
	# $1 — сколько секунд ждать (по умолчанию 25; после полного перезапуска — дольше)
	local i=0 p last="" same=0 max="${1:-25}"
	while [ $i -lt "$max" ]; do
		p=$(pidof sing-box 2>/dev/null)
		if [ -n "$p" ] && [ "$p" = "$last" ]; then
			same=$((same + 1))
			[ "$same" -ge 2 ] && return 0
		else
			same=0
		fi
		last="$p"
		sleep 1
		i=$((i + 1))
	done
	return 1
}

# ---------------------------------------------------------------------------
# update_cron — задача в /etc/crontabs/root по маркеру, без дублирования
# ---------------------------------------------------------------------------
cmd_update_cron() {
	config_load podkop_sub
	config_get ENABLED config enabled "1"
	config_get CRON    config cron    "24"

	local schedule=""
	# при выключенном сервисе задачу снимаем независимо от расписания
	if [ "$ENABLED" = "1" ]; then
		case "$CRON" in
			6)  schedule="0 */6 * * *" ;;
			12) schedule="0 */12 * * *" ;;
			24) schedule="0 4 * * *" ;;
			*)  schedule="" ;;   # 0 / off / прочее — задача удаляется
		esac
	fi

	mkdir -p "$(dirname "$CRON_FILE")"
	[ -f "$CRON_FILE" ] || touch "$CRON_FILE"
	# Сравниваем только СВОЮ строку, а не файл целиком: podkop при каждом
	# перезапуске переставляет свои строки, и порядок в файле меняется.
	local want=""
	[ -n "$schedule" ] && want="$schedule /usr/libexec/podkop_sub_service sync >/dev/null 2>&1 $CRON_MARK"
	if [ "$(grep -F "$CRON_MARK" "$CRON_FILE" 2>/dev/null)" = "$want" ]; then
		return 0                # уже как надо — crontab и cron не трогаем
	fi
	# новая версия файла: всё, кроме нашей строки, плюс (если нужно) наша строка
	local tmp="$CRON_FILE.tmp.$$" rc
	grep -v "$CRON_MARK" "$CRON_FILE" > "$tmp" 2>/dev/null
	rc=$?
	# grep: 0 — строки есть, 1 — чужих строк нет; всё прочее — ошибка чтения/записи.
	# При ошибке crontab не трогаем, иначе потеряли бы чужие задачи.
	if [ "$rc" -gt 1 ]; then
		rm -f "$tmp"
		log err "cannot rewrite $CRON_FILE — left untouched"
		return 1
	fi
	if [ -n "$want" ]; then
		echo "$want" >> "$tmp" || { rm -f "$tmp"; log err "cannot write $tmp"; return 1; }
	fi
	# cat, а не mv: сохраняем владельца и права существующего файла
	cat "$tmp" > "$CRON_FILE"
	rm -f "$tmp"
	[ -n "$schedule" ] && log info "cron set: $schedule" || log info "cron disabled"

	"$ROOT/etc/init.d/cron" enable  >/dev/null 2>&1
	"$ROOT/etc/init.d/cron" restart >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# status — JSON для UI: статус + разобранные ноды выбранной секции
# ---------------------------------------------------------------------------
cmd_status() {
	config_load podkop_sub
	config_get SECTION config section "main"
	local st ms up sub man
	config_get st  config last_status  ""
	config_get ms  config last_message ""
	config_get up  config last_update  "0"
	config_get sub config last_sub     "0"
	config_get man config last_manual  "0"

	# Собираем ноды секции и считаем РЕАЛЬНОЕ количество (а не сохранённое
	# last_count) — так счётчик всегда совпадает с таблицей.
	# Разбор ссылки на имя/протокол/хост/порт делает main.js (decodeURIComponent).
	local nodes_json="" cnt=0
	status_add() {
		case "$1" in
			vless://*) ;;
			*) return 0 ;;
		esac
		[ -n "$nodes_json" ] && nodes_json="$nodes_json,"
		nodes_json="$nodes_json\"$(printf '%s' "$1" | json_escape)\""
		cnt=$((cnt + 1))
	}
	config_load podkop
	config_list_foreach "$SECTION" urltest_proxy_links status_add
	# числа вставляются в JSON без кавычек — не даём мусору из конфига сломать ответ
	case "$up"  in ''|*[!0-9]*) up=0 ;;  esac
	case "$sub" in ''|*[!0-9]*) sub=0 ;; esac
	case "$man" in ''|*[!0-9]*) man=0 ;; esac

	local running="false" lpid
	lpid=$(cat "$LOCK/pid" 2>/dev/null)
	[ -n "$lpid" ] && kill -0 "$lpid" 2>/dev/null && running="true"
	local hasp="true" route=""
	podkop_installed || hasp="false"
	# пока идёт синхронизация, podkop перезапускается — состояние покажем по её окончании
	[ "$running" = "true" ] || route="$(route_state)"
	printf '{"running":%s,"podkop":%s,"route":"%s","version":"%s","status":"%s","message":"%s","last_update":%s,"count":%s,"sub":%s,"manual":%s,"section":"%s","nodes":[%s]}\n' \
		"$running" "$hasp" "$route" "$VERSION-$([ "$RELEASE" = dev ] && echo dev || echo "r$RELEASE")" \
		"$(printf '%s' "$st" | json_escape)" \
		"$(printf '%s' "$ms" | json_escape)" \
		"${up:-0}" "$cnt" "${sub:-0}" "${man:-0}" "$(printf '%s' "$SECTION" | json_escape)" \
		"$nodes_json"
}

# ---------------------------------------------------------------------------
# sections — JSON-массив имён секций из /etc/config/podkop
# ---------------------------------------------------------------------------
cmd_sections() {
	local first=1
	printf '['
	config_load podkop
	# секции типа 'section' — это цели podkop
	for s in $(uci -q show podkop | sed -n "s/^podkop\.\([^.=]*\)=section$/\1/p"); do
		[ $first -eq 0 ] && printf ','
		first=0
		printf '"%s"' "$(printf '%s' "$s" | json_escape)"
	done
	printf ']\n'
}

# ---------------------------------------------------------------------------
case "$1" in
	sync)        cmd_sync "$2" ;;
	update_cron) cmd_update_cron ;;
	status)      cmd_status ;;
	sections)    cmd_sections ;;
	check_deps)  check_deps ;;
	*)
		echo "usage: $0 {sync|update_cron|status|sections|check_deps}" >&2
		exit 1
		;;
esac
